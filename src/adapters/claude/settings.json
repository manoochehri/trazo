{
  "model": "haiku",
  "permissions": {
    "allow": [
      "Write(~/.claude/projects/*/memory/**)",
      "Edit(~/.claude/projects/*/memory/**)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(gh pr merge *)",
      "Bash(scripts/put_secret.sh *)",
      "Bash(gh secret *)",
      "Bash(gh variable set *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/**)",
      "Read(~/.gitconfig)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.trazo/hooks/pm_bash_guard.py\" --agent pm || exit 2"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.trazo/hooks/engineer_bash_guard.py\" --skip-agent pm || exit 2"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.trazo/hooks/agent_role_guard.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.trazo/hooks/front_door_guard.py\" || exit 2"
          }
        ]
      }
    ]
  }
}
