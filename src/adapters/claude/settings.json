{
  "model": "haiku",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(gh pr merge *)",
      "Bash(fly *)",
      "Bash(flyctl *)",
      "Bash(clasp push *)",
      "Bash(clasp deploy *)",
      "Bash(scripts/deploy*)",
      "Bash(./scripts/deploy*)",
      "Bash(scripts/put_secret.sh *)",
      "Bash(gh secret *)",
      "Bash(gh variable set *)",
      "Bash(gh workflow run *)"
    ]
  }
}
